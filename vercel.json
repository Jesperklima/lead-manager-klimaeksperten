{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/index(?:\\.html)?$",
      "dest": "/api/app",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "^/$",
      "dest": "/login.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "^/login$",
      "dest": "/login.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
        "X-Content-Type-Options": "nosniff"
      }
    },
    { "handle": "filesystem" }
  ]
}
